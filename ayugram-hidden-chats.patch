+constexpr uint32 kBlobMagic = 0x53435631U;
+constexpr uint32 kMaxEntries = 100000U;
+constexpr int kNonceSize = 16;
+constexpr int kMacSize = 32;
+constexpr int kSecretLength = 12;
+
+constexpr uchar kCodeSalt[16] = {
+	0x7A, 0x3F, 0x91, 0xC4, 0x5E, 0x82, 0x19, 0xD7,
+	0xB0, 0x4C, 0x63, 0xE8, 0x2D, 0xA5, 0x07, 0xF1,
+};
+
+constexpr uchar kExpectedCodeHash[32] = {
+	0x67, 0x79, 0xAE, 0x1E, 0x9A, 0x5E, 0x16, 0xB3,
+	0x50, 0x0B, 0x9B, 0x2A, 0x5B, 0x7F, 0xFB, 0x09,
+	0x7F, 0x60, 0xAB, 0x6F, 0x13, 0x23, 0x98, 0x36,
+	0x22, 0x36, 0xB6, 0xAB, 0xF1, 0xD5, 0x9B, 0xBD,
+};
+
+constexpr uchar kStorageEncKey[32] = {
+	0xC9, 0x14, 0x8B, 0x52, 0xE3, 0x6D, 0x47, 0xAF,
+	0x20, 0x9E, 0x71, 0x38, 0xFD, 0x05, 0xB6, 0xCA,
+	0x44, 0xD1, 0x89, 0x2F, 0x63, 0xBC, 0x17, 0x90,
+	0xEA, 0x58, 0x3C, 0x7E, 0xA2, 0x0B, 0xF4, 0x69,
+};
+
+constexpr uchar kStorageMacKey[32] = {
+	0x3B, 0xE7, 0x50, 0xA9, 0x1C, 0x84, 0xDF, 0x26,
+	0x95, 0x4D, 0xC2, 0x73, 0x08, 0xFA, 0x61, 0xBE,
+	0xD8, 0x29, 0x74, 0xCB, 0x10, 0x5F, 0xA3, 0x8E,
+	0x42, 0x97, 0xE5, 0x31, 0x6C, 0xB4, 0x0D, 0x7A,
+};
+
+QReadWriteLock gLock;
+std::unordered_set<uint64> gHiddenPeers;
+std::atomic<bool> gInitialized{ false };
+std::atomic<bool> gHasAnyHidden{ false };
+std::atomic<bool> gManageMode{ false };
+
+void writeLe32(uchar *dst, uint32 val) {
+	dst[0] = static_cast<uchar>(val & 0xFFU);
+	dst[1] = static_cast<uchar>((val >> 8) & 0xFFU);
+	dst[2] = static_cast<uchar>((val >> 16) & 0xFFU);
+	dst[3] = static_cast<uchar>((val >> 24) & 0xFFU);
+}
+
+void writeLe64(uchar *dst, uint64 val) {
+	for (auto i = 0; i < 8; ++i) {
+		dst[i] = static_cast<uchar>((val >> (i * 8)) & 0xFFULL);
+	}
+}
+
+[[nodiscard]] uint32 readLe32(const uchar *src) {
+	return uint32(src[0])
+		| (uint32(src[1]) << 8)
+		| (uint32(src[2]) << 16)
+		| (uint32(src[3]) << 24);
+}
+
+[[nodiscard]] uint64 readLe64(const uchar *src) {
+	uint64 val = 0;
+	for (auto i = 0; i < 8; ++i) {
+		val |= (uint64(src[i]) << (i * 8));
+	}
+	return val;
+}
+
+void xorKeystream(QByteArray &buffer, const uchar *nonce) {
+	const auto total = int(buffer.size());
+	uint32 counter = 0;
+	for (auto offset = 0; offset < total; offset += 32, ++counter) {
+		uchar ctr[4] = {};
+		writeLe32(ctr, counter);
+
+		QCryptographicHash hash(QCryptographicHash::Sha256);
+		hash.addData(QByteArrayView(
+			reinterpret_cast<const char*>(kStorageEncKey),
+			sizeof(kStorageEncKey)));
+		hash.addData(QByteArrayView(
+			reinterpret_cast<const char*>(nonce),
+			kNonceSize));
+		hash.addData(QByteArrayView(
+			reinterpret_cast<const char*>(ctr),
+			sizeof(ctr)));
+		const auto stream = hash.result();
+
+		const auto chunk = std::min(32, total - offset);
+		for (auto i = 0; i < chunk; ++i) {
+			buffer[offset + i] = static_cast<char>(
+				static_cast<uchar>(buffer[offset + i])
+				^ static_cast<uchar>(stream[i]));
+		}
+	}
+}
+
+[[nodiscard]] QByteArray computeMac(
+		const uchar *nonce,
+		QByteArrayView ciphertext) {
+	QCryptographicHash mac(QCryptographicHash::Sha256);
+	mac.addData(QByteArrayView(
+		reinterpret_cast<const char*>(kStorageMacKey),
+		sizeof(kStorageMacKey)));
+	mac.addData(QByteArrayView(
+		reinterpret_cast<const char*>(nonce),
+		kNonceSize));
+	mac.addData(ciphertext);
+	return mac.result();
+}
+
+[[nodiscard]] bool verifySecretCode(QStringView candidate) {
+	const auto trimmed = candidate.trimmed();
+	if (trimmed.size() != kSecretLength) {
+		return false;
+	}
+	const auto utf8 = trimmed.toUtf8();
+	QCryptographicHash hash(QCryptographicHash::Sha256);
+	hash.addData(QByteArrayView(
+		reinterpret_cast<const char*>(kCodeSalt),
+		sizeof(kCodeSalt)));
+	hash.addData(QByteArrayView(utf8.constData(), utf8.size()));
+	const auto digest = hash.result();
+	if (digest.size() != int(sizeof(kExpectedCodeHash))) {
+		return false;
+	}
+	uchar diff = 0;
+	for (auto i = 0; i < int(sizeof(kExpectedCodeHash)); ++i) {
+		diff |= (static_cast<uchar>(digest[i]) ^ kExpectedCodeHash[i]);
+	}
+	return (diff == 0);
+}
+
+[[nodiscard]] QString storageFilePath() {
+	const auto base = cWorkingDir().isEmpty() ? cExeDir() : cWorkingDir();
+	if (base.isEmpty()) {
+		return QString();
+	}
+	return QDir(base).filePath(u"tdata/user_scache0"_q);
+}
+
+void loadFromDisk() {
+	std::unordered_set<uint64> loaded;
+	const auto path = storageFilePath();
+	if (!path.isEmpty()) {
+		QFile file(path);
+		if (file.exists() && file.open(QIODevice::ReadOnly)) {
+			const auto raw = file.readAll();
+			if (raw.size() >= (kNonceSize + 8 + kMacSize)) {
+				const auto *bytes = reinterpret_cast<const uchar*>(
+					raw.constData());
+				const auto cipherLen = int(raw.size()) - kNonceSize - kMacSize;
+				const auto cipherView = QByteArrayView(
+					raw.constData() + kNonceSize,
+					cipherLen);
+				const auto expectedMac = computeMac(bytes, cipherView);
+				const auto *storedMac = bytes + kNonceSize + cipherLen;
+
+				uchar macDiff = 0;
+				for (auto i = 0; i < kMacSize; ++i) {
+					macDiff |= (static_cast<uchar>(expectedMac[i]) ^ storedMac[i]);
+				}
+				if (macDiff == 0) {
+					auto plain = QByteArray(
+						raw.constData() + kNonceSize,
+						cipherLen);
+					xorKeystream(plain, bytes);
+					const auto *p = reinterpret_cast<const uchar*>(
+						plain.constData());
+					const auto magic = readLe32(p);
+					const auto count = readLe32(p + 4);
+					if (magic == kBlobMagic
+						&& count <= kMaxEntries
+						&& uint64(plain.size()) == (8ULL + uint64(count) * 8ULL)) {
+						loaded.reserve(count);
+						for (uint32 i = 0; i < count; ++i) {
+							const auto v = readLe64(p + 8 + i * 8);
+							if (v != 0) {
+								loaded.insert(v);
+							}
+						}
+					}
+				}
+			}
+		}
+	}
+
+	const auto hasAny = !loaded.empty();
+	{
+		QWriteLocker locker(&gLock);
+		gHiddenPeers = std::move(loaded);
+	}
+	gHasAnyHidden.store(hasAny, std::memory_order_release);
+	gInitialized.store(true, std::memory_order_release);
+}
+
+void saveToDisk(const std::vector<uint64> &values) {
+	const auto path = storageFilePath();
+	if (path.isEmpty()) {
+		return;
+	}
+	if (values.empty()) {
+		QFile::remove(path);
+		return;
+	}
+
+	QDir().mkpath(QFileInfo(path).absolutePath());
+
+	uchar nonce[kNonceSize] = {};
+	writeLe64(nonce, QRandomGenerator::system()->generate64());
+	writeLe64(nonce + 8, QRandomGenerator::system()->generate64());
+
+	const auto count = static_cast<uint32>(
+		std::min<size_t>(values.size(), kMaxEntries));
+	QByteArray payload(int(8 + count * 8), Qt::Uninitialized);
+	auto *p = reinterpret_cast<uchar*>(payload.data());
+	writeLe32(p, kBlobMagic);
+	writeLe32(p + 4, count);
+	for (uint32 i = 0; i < count; ++i) {
+		writeLe64(p + 8 + i * 8, values[i]);
+	}
+
+	xorKeystream(payload, nonce);
+	const auto mac = computeMac(
+		nonce,
+		QByteArrayView(payload.constData(), payload.size()));
+
+	QByteArray out;
+	out.reserve(kNonceSize + payload.size() + kMacSize);
+	out.append(reinterpret_cast<const char*>(nonce), kNonceSize);
+	out.append(payload);
+	out.append(mac);
+
+	QSaveFile file(path);
+	if (file.open(QIODevice::WriteOnly)) {
+		file.write(out);
+		file.commit();
+	}
+}
+
+void refreshPeersInSession(
+		Data::Session &data,
+		const std::vector<not_null<PeerData*>> &peers) {
+	for (const auto peer : peers) {
+		if (isHidden(peer)) {
+			Core::App().closeChatFromWindows(peer);
+			if (const auto user = peer->asUser()) {
+				if (const auto history = data.historyLoaded(user)) {
+					data.contactsNoChatsList()->remove(history);
+					data.contactsList()->remove(history);
+				}
+			}
+			if (const auto history = data.historyLoaded(peer)) {
+				Core::App().notifications().clearFromHistory(history);
+				const auto wasInList = history->inChatList();
+				history->updateChatListExistence();
+				if (wasInList && !history->inChatList()) {
+					if (const auto folder = history->folder()) {
+						folder->unregisterOne(history);
+					}
+				}
+			}
+			if (const auto sublist = data.savedMessages().sublistLoaded(peer)) {
+				sublist->updateChatListExistence();
+			}
+		} else {
+			if (const auto user = peer->asUser()
+				; user && user->isLoaded() && user->isContact()) {
+				const auto history = data.history(user);
+				if (!data.contactsList()->contains(history)) {
+					data.contactsList()->addByName(history);
+				}
+			}
+			if (const auto history = data.historyLoaded(peer)) {
+				if (history->folderKnown()) {
+					const auto wasInList = history->inChatList();
+					history->updateChatListSortPosition();
+					history->updateChatListExistence();
+					if (!wasInList && history->inChatList()) {
+						if (const auto folder = history->folder()) {
+							folder->registerOne(history);
+						}
+					}
+				}
+			}
+			if (const auto user = peer->asUser()
+				; user && user->isLoaded() && user->isContact()) {
+				const auto history = data.history(user);
+				if (!history->inChatList()
+					&& !data.contactsNoChatsList()->contains(history)) {
+					data.contactsNoChatsList()->addByName(history);
+				}
+			}
+			if (const auto sublist = data.savedMessages().sublistLoaded(peer)) {
+				sublist->updateChatListSortPosition();
+				sublist->updateChatListExistence();
+			}
+		}
+	}
+
+	if (const auto archive = data.folderLoaded(Data::Folder::kId)) {
+		archive->updateChatListSortPosition();
+		archive->updateChatListExistence();
+		archive->updateChatListEntry();
+	}
+	data.notifyUnreadBadgeChanged();
+}
+
+void refreshAllSessions() {
+	if (!Core::IsAppLaunched()) {
+		return;
+	}
+	auto &domain = Core::App().domain();
+	if (!domain.started()) {
+		return;
+	}
+	for (const auto &[index, account] : domain.accounts()) {
+		if (const auto session = account->maybeSession()) {
+			auto &data = session->data();
+			std::vector<not_null<PeerData*>> targets;
+			data.enumerateUsers([&](not_null<UserData*> user) {
+				if (isConfiguredHidden(user)) {
+					targets.push_back(user);
+				}
+			});
+			data.enumerateGroups([&](not_null<PeerData*> group) {
+				if (isConfiguredHidden(group)) {
+					targets.push_back(group);
+				}
+			});
+			data.enumerateBroadcasts([&](not_null<ChannelData*> channel) {
+				if (isConfiguredHidden(channel)) {
+					targets.push_back(channel);
+				}
+			});
+			refreshPeersInSession(data, targets);
+		}
+	}
+	domain.notifyUnreadBadgeChanged();
+}
+
+void refreshSpecificPeersAcrossSessions(const std::vector<PeerId> &peerIds) {
+	if (!Core::IsAppLaunched()) {
+		return;
+	}
+	auto &domain = Core::App().domain();
+	if (!domain.started()) {
+		return;
+	}
+	for (const auto &[index, account] : domain.accounts()) {
+		if (const auto session = account->maybeSession()) {
+			auto &data = session->data();
+			std::vector<not_null<PeerData*>> targets;
+			for (const auto id : peerIds) {
+				if (const auto loaded = data.peerLoaded(id)) {
+					targets.push_back(loaded);
+				}
+			}
+			if (!targets.empty()) {
+				refreshPeersInSession(data, targets);
+			}
+		}
+	}
+	domain.notifyUnreadBadgeChanged();
+}
+
+} // namespace
+
+void init() {
+	gManageMode.store(false, std::memory_order_release);
+	loadFromDisk();
+}
+
+bool isManageMode() {
+	return gManageMode.load(std::memory_order_acquire);
+}
+
+bool isConfiguredHidden(PeerId peerId) {
+	if (!peerId) {
+		return false;
+	}
+	if (!gInitialized.load(std::memory_order_acquire)) {
+		init();
+	}
+	if (!gHasAnyHidden.load(std::memory_order_acquire)) {
+		return false;
+	}
+	QReadLocker locker(&gLock);
+	return gHiddenPeers.contains(peerId.value);
+}
+
+bool isConfiguredHidden(const PeerData *peer) {
+	if (!peer) {
+		return false;
+	}
+	if (isConfiguredHidden(peer->id)) {
+		return true;
+	}
+	if (const auto migrated = peer->migrateTo()) {
+		if (isConfiguredHidden(migrated->id)) {
+			return true;
+		}
+	}
+	if (const auto from = peer->migrateFrom()) {
+		if (isConfiguredHidden(from->id)) {
+			return true;
+		}
+	}
+	return false;
+}
+
+bool isConfiguredHidden(const History *history) {
+	return history && isConfiguredHidden(history->peer.get());
+}
+
+bool isConfiguredHidden(const HistoryItem *item) {
+	return item && isConfiguredHidden(item->history());
+}
+
+bool isHidden(PeerId peerId) {
+	return !isManageMode() && isConfiguredHidden(peerId);
+}
+
+bool isHidden(const PeerData *peer) {
+	return !isManageMode() && isConfiguredHidden(peer);
+}
+
+bool isHidden(const History *history) {
+	return !isManageMode() && isConfiguredHidden(history);
+}
+
+bool isHidden(const HistoryItem *item) {
+	return !isManageMode() && isConfiguredHidden(item);
+}
+
+bool tryHandleSecretSearchQuery(
+		const QString &query,
+		Window::SessionController *controller) {
+	if (!verifySecretCode(query)) {
+		return false;
+	}
+	if (!gInitialized.load(std::memory_order_acquire)) {
+		init();
+	}
+	const auto nextMode = !gManageMode.load(std::memory_order_acquire);
+	gManageMode.store(nextMode, std::memory_order_release);
+	refreshAllSessions();
+
+	if (controller) {
+		controller->showToast(nextMode
+			? u"Режим прихованих чатів увімкнено (до перезапуску)"_q
+			: u"Приховані чати приховано"_q);
+	}
+	return true;
+}
+
+void togglePeerHidden(
+		not_null<PeerData*> peer,
+		Window::SessionController *controller) {
+	if (peer->isSelf()) {
+		return;
+	}
+	if (!gInitialized.load(std::memory_order_acquire)) {
+		init();
+	}
+
+	std::vector<PeerId> relatedIds;
+	relatedIds.push_back(peer->id);
+	if (const auto migrated = peer->migrateTo()) {
+		relatedIds.push_back(migrated->id);
+	}
+	if (const auto from = peer->migrateFrom()) {
+		relatedIds.push_back(from->id);
+	}
+
+	const auto wasHidden = isConfiguredHidden(peer);
+	std::vector<uint64> snapshot;
+	bool hasAny = false;
+	{
+		QWriteLocker locker(&gLock);
+		if (wasHidden) {
+			for (const auto id : relatedIds) {
+				gHiddenPeers.erase(id.value);
+			}
+		} else {
+			for (const auto id : relatedIds) {
+				if (id.value != 0) {
+					gHiddenPeers.insert(id.value);
+				}
+			}
+		}
+		hasAny = !gHiddenPeers.empty();
+		snapshot.assign(gHiddenPeers.begin(), gHiddenPeers.end());
+	}
+	gHasAnyHidden.store(hasAny, std::memory_order_release);
+	saveToDisk(snapshot);
+	refreshSpecificPeersAcrossSessions(relatedIds);
+
+	if (controller) {
+		controller->showToast(wasHidden
+			? u"Чат прибрано з прихованих"_q
+			: u"Чат додано до прихованих (зникне після перезапуску або коду в пошуку)"_q);
+	}
+}
+
+void addContextMenuAction(
+		PeerData *peer,
+		not_null<Window::SessionController*> controller,
+		const Ui::Menu::MenuCallback &addCallback) {
+	if (!peer || peer->isSelf() || !isManageMode()) {
+		return;
+	}
+	const auto hidden = isConfiguredHidden(peer);
+	const auto nonNullPeer = not_null<PeerData*>(peer);
+	addCallback(
+		hidden
+			? u"Показати чат (не приховувати)"_q
+			: u"Приховати чат"_q,
+		[=] { togglePeerHidden(nonNullPeer, controller); },
+		hidden ? &st::menuIconShowInChat : &st::menuIconStealth);
+}
+
+} // namespace AyuHiddenChats
