+
+namespace AyuHiddenChats {
+namespace {
+
+constexpr auto kBotApiChannelPrefix = BareId(1000000000000ULL);
+
+struct HiddenSets {
+	std::unordered_set<BareId> userIds;
+	std::unordered_set<BareId> chatIds;
+	std::unordered_set<BareId> channelIds;
+	std::unordered_set<BareId> anyBareIds;
+
+	[[nodiscard]] bool empty() const {
+		return userIds.empty()
+			&& chatIds.empty()
+			&& channelIds.empty()
+			&& anyBareIds.empty();
+	}
+
+	[[nodiscard]] size_t totalCount() const {
+		return userIds.size()
+			+ chatIds.size()
+			+ channelIds.size()
+			+ anyBareIds.size();
+	}
+};
+
+QReadWriteLock gLock;
+HiddenSets gSets;
+std::atomic<bool> gInitialized{ false };
+
+[[nodiscard]] bool parseDigits(
+		QStringView sv,
+		bool allowLeadingMinus,
+		bool &wasNegative,
+		BareId &out) {
+	wasNegative = false;
+	if (sv.isEmpty()) {
+		return false;
+	}
+	if (allowLeadingMinus && sv.startsWith(u'-')) {
+		wasNegative = true;
+		sv = sv.mid(1);
+	} else if (sv.startsWith(u'+')) {
+		sv = sv.mid(1);
+	}
+	if (sv.isEmpty()) {
+		return false;
+	}
+	for (const auto ch : sv) {
+		if (ch < u'0' || ch > u'9') {
+			return false;
+		}
+	}
+	auto ok = false;
+	const auto parsed = sv.toULongLong(&ok);
+	if (!ok || parsed == 0) {
+		return false;
+	}
+	out = parsed;
+	return true;
+}
+
+void parseToken(const QString &rawToken, HiddenSets &sets) {
+	const auto token = rawToken.trimmed();
+	if (token.isEmpty()) {
+		return;
+	}
+
+	static const auto kPrivateLinkRe = QRegularExpression(
+		u"^(?:https?://)?t\\.me/c/(\\d+)(?:/.*)?$"_q,
+		QRegularExpression::CaseInsensitiveOption);
+	const auto linkMatch = kPrivateLinkRe.match(token);
+	if (linkMatch.hasMatch()) {
+		auto ok = false;
+		const auto channelBare = linkMatch.capturedView(1).toULongLong(&ok);
+		if (ok && channelBare > 0) {
+			sets.channelIds.insert(channelBare);
+		}
+		return;
+	}
+
+	const auto lower = token.toLower();
+	if (lower.startsWith(u"user:"_q)) {
+		auto neg = false;
+		BareId val = 0;
+		if (parseDigits(QStringView(token).mid(5), false, neg, val)) {
+			sets.userIds.insert(val);
+		}
+		return;
+	}
+	if (lower.startsWith(u"chat:"_q)) {
+		auto neg = false;
+		BareId val = 0;
+		if (parseDigits(QStringView(token).mid(5), true, neg, val)) {
+			sets.chatIds.insert(val);
+		}
+		return;
+	}
+	if (lower.startsWith(u"channel:"_q)) {
+		auto neg = false;
+		BareId val = 0;
+		if (parseDigits(QStringView(token).mid(8), true, neg, val)) {
+			if (neg && val > kBotApiChannelPrefix) {
+				val -= kBotApiChannelPrefix;
+			}
+			sets.channelIds.insert(val);
+		}
+		return;
+	}
+
+	auto isNegative = false;
+	BareId absVal = 0;
+	if (!parseDigits(token, true, isNegative, absVal)) {
+		return;
+	}
+
+	if (isNegative) {
+		if (absVal > kBotApiChannelPrefix) {
+			sets.channelIds.insert(absVal - kBotApiChannelPrefix);
+		} else {
+			sets.chatIds.insert(absVal);
+			sets.channelIds.insert(absVal);
+		}
+	} else {
+		sets.anyBareIds.insert(absVal);
+	}
+}
+
+void parseLine(QString line, HiddenSets &sets) {
+	if (line.endsWith(u'\r')) {
+		line.chop(1);
+	}
+	auto cut = line.size();
+	if (const auto hashPos = line.indexOf(u'#'); hashPos >= 0) {
+		cut = std::min(cut, hashPos);
+	}
+	qsizetype searchFrom = 0;
+	while (searchFrom < cut) {
+		const auto slashPos = line.indexOf(u"//"_q, searchFrom);
+		if (slashPos < 0 || slashPos >= cut) {
+			break;
+		}
+		if (slashPos == 0 || line.at(slashPos - 1) != u':') {
+			cut = slashPos;
+			break;
+		}
+		searchFrom = slashPos + 2;
+	}
+	const auto body = line.left(cut).trimmed();
+	if (body.isEmpty()) {
+		return;
+	}
+	static const auto kSepRe = QRegularExpression(u"[\\s,;]+"_q);
+	const auto tokens = body.split(kSepRe, Qt::SkipEmptyParts);
+	for (const auto &token : tokens) {
+		parseToken(token, sets);
+	}
+}
+
+[[nodiscard]] std::vector<QString> collectCandidatePaths() {
+	std::vector<QString> result;
+	const auto addIfValid = [&](const QString &base, const QString &rel) {
+		if (!base.isEmpty()) {
+			result.push_back(QDir(base).filePath(rel));
+		}
+	};
+	addIfValid(cWorkingDir(), u"tdata/hidden_chats.txt"_q);
+	addIfValid(cWorkingDir(), u"hidden_chats.txt"_q);
+	addIfValid(cExeDir(), u"hidden_chats.txt"_q);
+	return result;
+}
+
+} // namespace
+
+void init() {
+	reload();
+}
+
+void reload() {
+	HiddenSets nextSets;
+	base::flat_set<QString> seenCanonicalPaths;
+
+	for (const auto &candidate : collectCandidatePaths()) {
+		const auto info = QFileInfo(candidate);
+		if (!info.exists() || !info.isFile()) {
+			continue;
+		}
+		const auto canonical = info.canonicalFilePath();
+		const auto dedupKey = canonical.isEmpty() ? candidate : canonical;
+		if (!seenCanonicalPaths.insert(dedupKey).second) {
+			continue;
+		}
+		QFile file(candidate);
+		if (!file.open(QIODevice::ReadOnly)) {
+			continue;
+		}
+		auto content = QString::fromUtf8(file.readAll());
+		if (content.startsWith(QChar(0xFEFF))) {
+			content.remove(0, 1);
+		}
+		const auto lines = content.split(u'\n');
+		for (const auto &line : lines) {
+			parseLine(line, nextSets);
+		}
+	}
+
+	{
+		QWriteLocker locker(&gLock);
+		gSets = std::move(nextSets);
+	}
+	gInitialized.store(true, std::memory_order_release);
+
+	QReadLocker locker(&gLock);
+	LOG(("AyuHiddenChats: loaded %1 entries")
+		.arg(static_cast<qulonglong>(gSets.totalCount())));
+}
+
+bool isHidden(PeerId peerId) {
+	if (!peerId) {
+		return false;
+	}
+	if (!gInitialized.load(std::memory_order_acquire)) {
+		init();
+	}
+	QReadLocker locker(&gLock);
+	if (gSets.empty()) {
+		return false;
+	}
+	if (peerIsUser(peerId)) {
+		const auto bare = peerToUser(peerId).bare;
+		return gSets.userIds.contains(bare)
+			|| gSets.anyBareIds.contains(bare);
+	}
+	if (peerIsChat(peerId)) {
+		const auto bare = peerToChat(peerId).bare;
+		return gSets.chatIds.contains(bare)
+			|| gSets.anyBareIds.contains(bare);
+	}
+	if (peerIsChannel(peerId)) {
+		const auto bare = peerToChannel(peerId).bare;
+		return gSets.channelIds.contains(bare)
+			|| gSets.anyBareIds.contains(bare);
+	}
+	return false;
+}
+
+bool isHidden(const PeerData *peer) {
+	if (!peer) {
+		return false;
+	}
+	if (isHidden(peer->id)) {
+		return true;
+	}
+	if (const auto migrated = peer->migrateTo()) {
+		if (isHidden(migrated->id)) {
+			return true;
+		}
+	}
+	if (const auto from = peer->migrateFrom()) {
+		if (isHidden(from->id)) {
+			return true;
+		}
+	}
+	return false;
+}
+
+bool isHidden(const History *history) {
+	return history && isHidden(history->peer.get());
+}
+
+bool isHidden(const HistoryItem *item) {
+	return item && isHidden(item->history());
+}
+
+} // namespace AyuHiddenChats
